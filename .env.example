# Copy to .env and fill in. Never commit .env.

# ---- Model providers: "openai" (any OpenAI-compatible API) or "fake" (tests only)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Leave blank for api.openai.com. Set for OpenAI-compatible servers, e.g. Ollama:
#   OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# ---- Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retrieval
TOP_K=4
# Optional L2-distance cut-off (lower = stricter). Blank = keep all top-k.
MAX_DISTANCE=

# ---- Storage
FAISS_INDEX_DIR=data/faiss_index
UPLOAD_DIR=data/uploads
SAVE_UPLOADS=true

# ---- Ingestion limits
MAX_UPLOAD_MB=25
MAX_URL_MB=15
URL_TIMEOUT_SECONDS=20
MIN_CHARS_PER_SOURCE=50
# Keep false unless you need to ingest from localhost/intranet hosts.
ALLOW_PRIVATE_URLS=false

# ---- Guardrails
# Block questions that try to override the assistant's instructions
GUARDRAIL_BLOCK_INJECTION=true
# Refuse non-agriculture questions (one short extra model call per question)
GUARDRAIL_TOPIC_CHECK=true
# Withhold answers that cite no source passage (set false for small local models that forget citations)
GUARDRAIL_REQUIRE_CITATIONS=true

# ---- Embedding cache (embeddings are stored and never recomputed for the same text + model)
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=data/embedding_cache

LOG_LEVEL=INFO

# ---- Streamlit UI
API_BASE_URL=http://localhost:8000
